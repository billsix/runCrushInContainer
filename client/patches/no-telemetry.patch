+	// Hard-disabled at build time by no-telemetry.patch (runCrushInContainer):
+	// event.Init is never called, so the PostHog client is never constructed and
+	// https://data.charm.land is unreachable regardless of env or config.
+	return false
 	if v, _ := strconv.ParseBool(os.Getenv("CRUSH_DISABLE_METRICS")); v {
