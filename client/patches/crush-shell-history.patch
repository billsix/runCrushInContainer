diff --git a/internal/ui/dialog/history.go b/internal/ui/dialog/history.go
new file mode 100644
index 0000000..0f09e8b
--- /dev/null
+++ b/internal/ui/dialog/history.go
@@ -0,0 +1,267 @@
+package dialog
+
+import (
+	"strings"
+
+	"charm.land/bubbles/v2/help"
+	"charm.land/bubbles/v2/key"
+	"charm.land/bubbles/v2/textinput"
+	tea "charm.land/bubbletea/v2"
+	"github.com/charmbracelet/crush/internal/ui/common"
+	"github.com/charmbracelet/crush/internal/ui/list"
+	"github.com/charmbracelet/crush/internal/ui/styles"
+	uv "github.com/charmbracelet/ultraviolet"
+	"github.com/sahilm/fuzzy"
+)
+
+// HistoryID is the identifier for the prompt-history search dialog.
+const HistoryID = "history"
+
+// ActionInsertPrompt asks the caller to put a recalled history entry into
+// the editor, unsent -- the same thing Up does, reached by searching.
+type ActionInsertPrompt struct {
+	// Text is the history entry, with its "!" prefix still attached when it
+	// was a shell command; the editor decides what bang mode to enter.
+	Text string
+}
+
+// HistoryItem wraps one prompt-history entry as a searchable list item.
+type HistoryItem struct {
+	*list.Versioned
+	t       *styles.Styles
+	text    string
+	title   string
+	index   int
+	m       fuzzy.Match
+	cache   map[int]string
+	focused bool
+}
+
+var _ ListItem = &HistoryItem{}
+
+// newHistoryItem builds a list item for one history entry. index is the
+// entry's position in the history (0 = most recent) and is what makes the
+// item's ID unique -- history entries repeat, so the text cannot.
+func newHistoryItem(t *styles.Styles, text string, index int) *HistoryItem {
+	return &HistoryItem{
+		Versioned: list.NewVersioned(),
+		t:         t,
+		text:      text,
+		title:     oneLine(text),
+		index:     index,
+	}
+}
+
+// oneLine flattens a multi-line prompt onto a single row: a list row is one
+// line tall, so the raw text would otherwise be silently cut at its first
+// newline and two different prompts could look identical.
+func oneLine(s string) string {
+	return strings.Join(strings.Fields(s), " ")
+}
+
+// Finished implements list.Item. History entries never change once loaded;
+// SetFocused and SetMatch bump the version themselves.
+func (h *HistoryItem) Finished() bool { return true }
+
+// Filter returns the value the fuzzy search matches against.
+func (h *HistoryItem) Filter() string { return h.title }
+
+// ID returns a unique identifier for the entry.
+func (h *HistoryItem) ID() string { return h.title }
+
+// Text returns the entry as it should be inserted into the editor -- the
+// original, not the flattened one-line form shown in the list.
+func (h *HistoryItem) Text() string { return h.text }
+
+// SetMatch sets the fuzzy match for the item.
+func (h *HistoryItem) SetMatch(m fuzzy.Match) {
+	if sameFuzzyMatch(h.m, m) {
+		return
+	}
+	h.cache = nil
+	h.m = m
+	if h.Versioned != nil {
+		h.Bump()
+	}
+}
+
+// SetFocused sets the focus state of the item.
+func (h *HistoryItem) SetFocused(focused bool) {
+	if h.focused == focused {
+		return
+	}
+	h.cache = nil
+	h.focused = focused
+	if h.Versioned != nil {
+		h.Bump()
+	}
+}
+
+// Render implements list.Item.
+func (h *HistoryItem) Render(width int) string {
+	return renderItem(ListItemStyles{
+		ItemBlurred:     h.t.Dialog.NormalItem,
+		ItemFocused:     h.t.Dialog.SelectedItem,
+		InfoTextBlurred: h.t.Dialog.Sessions.InfoBlurred,
+		InfoTextFocused: h.t.Dialog.Sessions.InfoFocused,
+	}, h.title, "", h.focused, width, h.cache, &h.m)
+}
+
+// History is the prompt-history search dialog: the reverse-search a shell
+// gives you on ctrl+r, as a filtered picker. Typing narrows the list;
+// enter puts the selection in the editor without sending it.
+type History struct {
+	com   *common.Common
+	help  help.Model
+	list  *list.FilterableList
+	input textinput.Model
+
+	keyMap struct {
+		Select   key.Binding
+		Next     key.Binding
+		Previous key.Binding
+		UpDown   key.Binding
+		Close    key.Binding
+	}
+}
+
+var _ Dialog = (*History)(nil)
+
+// NewHistory creates the prompt-history search dialog over entries, which
+// must already be in most-recent-first order (the order loadPromptHistory
+// returns).
+func NewHistory(com *common.Common, entries []string) *History {
+	h := new(History)
+	h.com = com
+
+	items := make([]list.FilterableItem, 0, len(entries))
+	for i, entry := range entries {
+		if strings.TrimSpace(entry) == "" {
+			continue
+		}
+		items = append(items, newHistoryItem(com.Styles, entry, i))
+	}
+
+	hlp := help.New()
+	hlp.Styles = com.Styles.DialogHelpStyles()
+	h.help = hlp
+
+	h.list = list.NewFilterableList(items...)
+	h.list.Focus()
+	h.list.SetSelected(0)
+
+	h.input = textinput.New()
+	h.input.SetVirtualCursor(false)
+	h.input.Placeholder = "Search prompt history"
+	h.input.SetStyles(com.Styles.TextInput)
+	h.input.Focus()
+
+	h.keyMap.Select = key.NewBinding(
+		key.WithKeys("enter", "tab", "ctrl+y"),
+		key.WithHelp("enter", "insert"),
+	)
+	// ctrl+r repeats the search downward, the way holding it in bash walks
+	// back through older matches.
+	h.keyMap.Next = key.NewBinding(
+		key.WithKeys("down", "ctrl+n", "ctrl+r"),
+		key.WithHelp("↓", "next match"),
+	)
+	h.keyMap.Previous = key.NewBinding(
+		key.WithKeys("up", "ctrl+p"),
+		key.WithHelp("↑", "previous match"),
+	)
+	h.keyMap.UpDown = key.NewBinding(
+		key.WithKeys("up", "down"),
+		key.WithHelp("↑↓", "choose"),
+	)
+	h.keyMap.Close = CloseKey
+
+	return h
+}
+
+// ID implements Dialog.
+func (h *History) ID() string { return HistoryID }
+
+// HandleMsg implements Dialog.
+func (h *History) HandleMsg(msg tea.Msg) Action {
+	switch msg := msg.(type) {
+	case tea.KeyPressMsg:
+		switch {
+		case key.Matches(msg, h.keyMap.Close):
+			return ActionClose{}
+		case key.Matches(msg, h.keyMap.Previous):
+			h.list.Focus()
+			if h.list.IsSelectedFirst() {
+				h.list.SelectLast()
+			} else {
+				h.list.SelectPrev()
+			}
+			h.list.ScrollToSelected()
+		case key.Matches(msg, h.keyMap.Next):
+			h.list.Focus()
+			if h.list.IsSelectedLast() {
+				h.list.SelectFirst()
+			} else {
+				h.list.SelectNext()
+			}
+			h.list.ScrollToSelected()
+		case key.Matches(msg, h.keyMap.Select):
+			if item := h.list.SelectedItem(); item != nil {
+				if historyItem, ok := item.(*HistoryItem); ok {
+					return ActionInsertPrompt{Text: historyItem.Text()}
+				}
+			}
+			return ActionClose{}
+		default:
+			var cmd tea.Cmd
+			h.input, cmd = h.input.Update(msg)
+			h.list.SetFilter(h.input.Value())
+			h.list.ScrollToTop()
+			h.list.SetSelected(0)
+			return ActionCmd{cmd}
+		}
+	}
+	return nil
+}
+
+// Cursor returns the cursor position relative to the dialog.
+func (h *History) Cursor() *tea.Cursor {
+	return InputCursor(h.com.Styles, h.input.Cursor())
+}
+
+// Draw implements Dialog.
+func (h *History) Draw(scr uv.Screen, area uv.Rectangle) *tea.Cursor {
+	t := h.com.Styles
+	width := max(0, min(defaultDialogMaxWidth, area.Dx()-t.Dialog.View.GetHorizontalBorderSize()))
+	height := max(0, min(defaultDialogHeight, area.Dy()-t.Dialog.View.GetVerticalBorderSize()))
+	innerWidth := width - t.Dialog.View.GetHorizontalFrameSize()
+	h.input.SetWidth(dialogInputTextWidth(t, h.input, innerWidth))
+	listHeight, listTotalHeight, _ := sizeDialogList(t, h.list, innerWidth, height)
+
+	rc := NewRenderContext(t, width)
+	rc.Title = "History"
+	rc.AddPart(t.Dialog.InputPrompt.Render(h.input.View()))
+	cur := h.Cursor()
+
+	listView := t.Dialog.List.Height(h.list.Height()).Render(h.list.Render())
+	listView = joinScrollbar(t, listView, listHeight, listTotalHeight, listHeight, h.list.Offset())
+	rc.AddPart(listView)
+	rc.Help = renderDialogHelp(t, &h.help, h, innerWidth)
+
+	DrawCenterCursor(scr, area, rc.Render(), cur)
+	return cur
+}
+
+// ShortHelp implements help.KeyMap.
+func (h *History) ShortHelp() []key.Binding {
+	return []key.Binding{
+		h.keyMap.Select,
+		h.keyMap.UpDown,
+		h.keyMap.Close,
+	}
+}
+
+// FullHelp implements help.KeyMap.
+func (h *History) FullHelp() [][]key.Binding {
+	return [][]key.Binding{h.ShortHelp()}
+}
