 }
+
+// A prompt must be recallable with one Up immediately after it is submitted.
+// The database cannot supply this: the row is written asynchronously by the
+// agent run, so the reload that used to run at submit time returned a list
+// without the prompt in it, and the first Up landed on the one before.
+func TestHistoryPushMakesTheLastPromptTheFirstRecalled(t *testing.T) {
+	t.Parallel()
+
+	u := newTestUI()
+	u.com.Workspace = historyWorkspace{}
+	u.promptHistory.messages = []string{"older", "oldest"}
+	u.promptHistory.index = -1
+
+	u.historyPush("just sent")
+
+	require.True(t, u.historyPrev())
+	require.Equal(t, "just sent", u.textarea.Value())
+	require.True(t, u.historyPrev())
+	require.Equal(t, "older", u.textarea.Value())
+	require.True(t, u.historyPrev())
+	require.Equal(t, "oldest", u.textarea.Value())
+	require.False(t, u.historyPrev())
+}
+
+// Repeating the same prompt should not stack duplicate entries, matching
+// bash under HISTCONTROL=ignoredups.
+func TestHistoryPushSkipsConsecutiveDuplicates(t *testing.T) {
+	t.Parallel()
+
+	u := newTestUI()
+	u.com.Workspace = historyWorkspace{}
+
+	u.historyPush("same")
+	u.historyPush("same")
+	u.historyPush("different")
+	u.historyPush("same")
+
+	require.Equal(t, []string{"same", "different", "same"}, u.promptHistory.messages)
+}
+
+// A bang command is recorded with its "!" restored, the form
+// loadPromptHistory stores shell commands in, so recalling it re-enters
+// bang mode.
+func TestHistoryPushRestoresBangPrefix(t *testing.T) {
+	t.Parallel()
+
+	u := newTestUI()
+	u.com.Workspace = historyWorkspace{}
+
+	u.historyPush("!git status")
+
+	require.Equal(t, []string{"!git status"}, u.promptHistory.messages)
+	require.True(t, u.historyPrev())
+	require.True(t, u.bangMode)
+	require.Equal(t, "git status", u.textarea.Value())
+}
+
+// An empty submission must not create a blank history entry.
+func TestHistoryPushIgnoresEmpty(t *testing.T) {
+	t.Parallel()
+
+	u := newTestUI()
+	u.com.Workspace = historyWorkspace{}
+	u.promptHistory.messages = []string{"kept"}
+
+	u.historyPush("")
+
+	require.Equal(t, []string{"kept"}, u.promptHistory.messages)
+}
