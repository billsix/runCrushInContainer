+// historyPush records a just-submitted prompt at the front of the in-memory
+// history, so the next Up recalls it the way a shell does.  Reloading from the
+// database cannot do this at submit time: the row is written asynchronously by
+// the agent run (AgentRun returns once the prompt has been ACCEPTED, not once
+// it is stored), so a reload issued alongside the submit returns a list that
+// does not contain the prompt yet -- which is why Up used to skip it.
+//
+// Shell commands are pushed with their "!" restored, matching how
+// loadPromptHistory stores them.
+func (m *UI) historyPush(text string) {
+	m.historyReset()
+	if text == "" {
+		return
+	}
+	if len(m.promptHistory.messages) > 0 && m.promptHistory.messages[0] == text {
+		// consecutive duplicate, as bash under HISTCONTROL=ignoredups
+		return
+	}
+	m.promptHistory.messages = append([]string{text}, m.promptHistory.messages...)
+}
+
 // historyReset resets the history, but does not clear the message
 // it just sets the current draft to empty and the position in the history.
 func (m *UI) historyReset() {
