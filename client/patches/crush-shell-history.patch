 // openCommandsDialog opens the commands dialog.
+// openHistoryDialog opens the prompt-history search over whatever history is
+// currently loaded -- no query of its own, so the dialog cannot disagree with
+// what Up would show.
+func (m *UI) openHistoryDialog() tea.Cmd {
+	if m.dialog.ContainsDialog(dialog.HistoryID) {
+		m.dialog.BringToFront(dialog.HistoryID)
+		return nil
+	}
+	if len(m.promptHistory.messages) == 0 {
