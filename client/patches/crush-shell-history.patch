@@ -0,0 +1,31 @@
+package dialog
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+// A list row is one line tall, so a multi-line prompt has to be flattened
+// for display -- but Text() must still hand back the original, or recalling
+// an entry would silently rewrite the prompt.
+func TestHistoryItemFlattensForDisplayButRecallsTheOriginal(t *testing.T) {
+	t.Parallel()
+
+	const raw = "first line\n  second line\n\nthird"
+	item := newHistoryItem(nil, raw, 0)
+
+	require.Equal(t, "first line second line third", item.Filter())
+	require.Equal(t, raw, item.Text())
+}
+
+// Shell commands keep their "!" so the editor re-enters bang mode when the
+// entry is inserted.
+func TestHistoryItemKeepsBangPrefix(t *testing.T) {
+	t.Parallel()
+
+	item := newHistoryItem(nil, "!git status", 3)
+
+	require.Equal(t, "!git status", item.Text())
+	require.Equal(t, "!git status", item.Filter())
+}
