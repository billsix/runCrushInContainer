alias ls='ls --color=auto'
export GPG_TTY=$(tty)

# Default the nested-podman ENV flag ON in this dev sandbox, so downstream project
# `make` targets run inside it auto-apply --cgroups=disabled without passing
# NESTED_PODMAN=1 every launch. Only defaulted when unset, so an explicit
# `make shell NESTED_PODMAN=1` (or =0 to disable) on the host still wins. This lives in
# the sandbox's own .extrabashrc, so it only affects dev sessions in THIS sandbox — it
# is not baked into any downstream project a consumer builds. (ENV half only; the host
# launch still supplies /dev/fuse + caps that make nested podman actually work.)
if [ -z "${NESTED_PODMAN:-}" ]; then
    export NESTED_PODMAN=1
fi
PS1='\[\e[36m\]┌─(\t) \[\e[32m\]\u@\h:\w\n\[\e[36m\]└─λ \[\e[0m\]'
