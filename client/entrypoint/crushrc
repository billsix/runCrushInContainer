# ~/.config/crush/crushrc — baked default for the runCrushInContainer client.
#
# Declares exactly two providers -- the local models served by llama.cpp on the Mac, reached
# through the host's SSH tunnel: Muse Glimmer on port 8080 and Gemma 4 on port 8081. Both models
# are pinned EXPLICITLY (not auto-discovered) and the built-in provider catalog is suppressed --
# see the provider/model blocks below. Glimmer is preselected; switch with Crush's model dialog
# (ctrl+l) like any other provider.
#
# Reachability: the client runs with `podman run --network=host`, so 127.0.0.1:8080/8081 inside
# the container are the host's forwarded ports. On the host, keep the tunnel open (both ports):
#     ssh -N -L 8080:127.0.0.1:8080 -L 8081:127.0.0.1:8081 you@mac-studio
# The ports are FIXED per model in server/Makefile (MODEL_PORT_glimmer / MODEL_PORT_gemma), on
# purpose: this file and the tunnel never have to be told which model is where. Keep the three
# in sync if a port ever changes.
#
# NOTE: crushrc runs as a full shell script at load time — treat it as trusted code.

# --- Cross-project conventions (the runClaudeInContainer working-method port) ---
# Register the baked conventions file as a global context path so Crush loads it and splices it
# into the system prompt every session, before executing anything. Its `@`-import lines (expanded
# by the patched Crush, CRUSH_AT_IMPORT) pull in the reference docs + the personal overlay. A
# mounted project's own /work/CLAUDE.md still auto-loads on top of this. See
# tasks/port-runclaude-conventions-systems.md.
option global-context-path /root/.config/crush/CLAUDE.md

# --- Privacy: no telemetry ---
# Disable Crush's PostHog usage telemetry (endpoint data.charm.land). The image ALSO sets
# CRUSH_DISABLE_METRICS=1 / DO_NOT_TRACK=1 (Dockerfile ENV) — that env is the robust,
# launch-independent guarantee; this line documents the intent in the config the user reads and
# covers a config-only build. `metrics` is inverted, so `false` sets options.disable_metrics=true.
# (The unsolicited GitHub update check is disabled by a source patch — see
# client/patches/crush-no-update-check.patch and tasks/disable-crush-telemetry.md.)
option metrics false

# Offer ONLY this provider — never Crush's built-in Catwalk catalog. Without this, Crush
# shows ~15-20 embedded models (and, if our provider is ever dropped, falls into an onboarding
# picker of them). `default-providers` is inverted, so `false` = "do NOT include the built-in
# providers" (sets disable_default_providers=true). See
# tasks/suppress-embedded-provider-catalog.md.
option default-providers false

provider add muse-glimmer \
  --name "Muse Glimmer (local llama.cpp)" \
  --type llamacpp \
  --base-url "http://127.0.0.1:8080" \
  --api-key "local-no-key-needed"

# Pin the model EXPLICITLY rather than relying on runtime auto-discovery. Discovery hits
# GET /v1/models with a 3s timeout at startup; if the tunnel/server isn't reachable yet, Crush
# deletes the provider and shows the built-in catalog. An explicit model has no such
# dependency. The ID must match what the server reports at /v1/models — the server is pinned to
# `--alias muse-glimmer` (server/Makefile MODEL_ALIAS), so this stays constant across quant/file
# changes. --context-window matches the server's -c/CTX (65536) so Crush's compaction math lines
# up (see tasks/archive/2026/08/20/context-window-sizing.md).
model add muse-glimmer/muse-glimmer --name "Muse Glimmer 30B" --context-window 65536

# The second model: Google's Gemma 4 26B-A4B (Apache-2.0), served by `make serve MODEL=gemma` on
# its fixed port 8081 with `--alias gemma-4` (server/Makefile MODEL_ALIAS_gemma). Same explicit-pin
# reasoning as above; same CTX (65536). Rationale and the licence check that let it in:
# tasks/reference/gemma-4-alongside-glimmer.md.
provider add gemma-4 \
  --name "Gemma 4 26B-A4B (local llama.cpp)" \
  --type llamacpp \
  --base-url "http://127.0.0.1:8081" \
  --api-key "local-no-key-needed"

model add gemma-4/gemma-4 --name "Gemma 4 26B-A4B" --context-window 65536

# Preselect Glimmer for both slots so Crush uses it immediately — no model picker at startup.
# Gemma 4 is one ctrl+l away (the models dialog lists both providers).
model large muse-glimmer/muse-glimmer
model small muse-glimmer/muse-glimmer

# --- Language servers: declared explicitly, dnf-installed, one per toolchain Fedora packages ---
# Crush bundles no servers; without these lines it auto-starts registry-known servers only when
# they pass four gates (not user-configured, not on its skip list, filetype + a root marker under
# /work, on PATH) and otherwise answers "no LSP client handles file" — which is what the maintainer
# saw for Python. An explicit `lsp add` skips every gate: the server starts for its filetypes, full
# stop. Every binary below comes from dnf in 01-install-base.sh (the airgap rebuild has only a dnf
# mirror, so no npm/gem/opam/pip servers — maintainer's rule, 2026-09-10); toolchains Fedora ships no
# server for (JS/TS, Lua, LaTeX, Haskell, Java, OCaml, Ruby, TOML, Markdown, YAML, Dockerfile, Emacs
# Lisp) deliberately have no line. Capability sets per server and the RHEL 9 variant (a /venv `ty`
# — same line, different install): tasks/reference/crush-lsp-integration.md.
# `ruff` is in the image for format.sh only — diagnostics-only and on Crush's skip list, no LSP role.
lsp add python --command ty --args server --filetypes py --root-markers pyproject.toml setup.py .git
lsp add go --command gopls --filetypes go --root-markers go.mod go.work .git
lsp add c --command clangd --filetypes c cpp h hpp --root-markers compile_commands.json CMakeLists.txt Makefile .git
lsp add rust --command rust-analyzer --filetypes rs --root-markers Cargo.toml .git
lsp add sh --command bash-language-server --args start --filetypes sh bash --root-markers .git
# glsl_analyzer (underscore — the Fedora package is glsl-analyzer) offers definition + diagnostics
# only; enough for mvp's shader trees, and free.
lsp add glsl --command glsl_analyzer --filetypes glsl vert frag comp --root-markers .git

# --- Permissions: auto-allow file read/write, ask for everything else ---
# The client is a throwaway container and the constant prompts for FILE ACCESS (read/write) are the
# real pain — so auto-allow just the file tools. EVERYTHING ELSE stays on ask (Crush's default),
# deliberately conservative: `bash`, network (`fetch`/`agentic_fetch`/`download`/`sourcegraph`), MCP
# (`list_mcp_resources`/`read_mcp_resource`), the `lsp_*` tools, sub-agents (`agent`), etc. all still
# prompt. `permissions allow` skips the prompt ONLY for the listed tools; unlisted and any
# newly-added tools ask (fail-safe). Tool names are Crush's registry (internal/config allToolNames).
# See the archived task auto-allow-local-file-tools.md.
permissions allow view edit multiedit write ls glob grep
