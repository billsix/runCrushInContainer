# ~/.config/crush/crushrc — baked default for the runCrushInContainer client.
#
# AUTODISCOVERS the local models served by llama.cpp on the Mac, reached through the host's SSH
# tunnel. Each model has a FIXED port in server/Makefile (MODEL_PORT_<m>): Muse Glimmer 8080,
# Gemma 4 8081, IBM Granite Code 8082, Devstral 8083, Qwen3-Coder 8084. At load this file PROBES
# each port and registers a provider ONLY for the ones that answer, then preselects the first live
# one; switch any time with Crush's model dialog (ctrl+l). The built-in provider catalog is
# suppressed (see `option default-providers` below).
#
# Which models are actually live is gated on the SERVER by MODEL_COUNTRIES (server/Makefile,
# default US) -- the server only serves an allowed-country model, so only its port answers, so only
# it is offered here. That is how the country allowlist reaches the client: by liveness, NOT by
# this file knowing the flag. (A 36 GB Mac serves ONE model at a time, so usually one port answers.)
#
# Reachability: the client runs with `podman run --network=host`, so 127.0.0.1:808x inside the
# container are the host's forwarded ports. On the host, keep the tunnel open for whichever ports
# you serve (forwarding a port nothing serves is harmless):
#     ssh -N -L 8080:127.0.0.1:8080 -L 8081:127.0.0.1:8081 -L 8082:127.0.0.1:8082 \
#            -L 8083:127.0.0.1:8083 -L 8084:127.0.0.1:8084 you@mac-studio
# KEEP THE PORT/ALIAS TABLE BELOW IN SYNC with server/Makefile (MODEL_PORT_<m> / MODEL_ALIAS_<m>)
# and client/entrypoint/shell.sh (the LOCALHOST_ONLY socket-bridge port list).
#
# NOTE: crushrc runs as a full shell script at load time — treat it as trusted code.

# --- Cross-project conventions (the runClaudeInContainer working-method port) ---
# Register the baked conventions file as a global context path so Crush loads it and splices it
# into the system prompt every session, before executing anything. Its `@`-import lines (expanded
# by the patched Crush, CRUSH_AT_IMPORT) pull in the reference docs + the personal overlay. A
# mounted project's own /work/CLAUDE.md still auto-loads on top of this. See
# tasks/port-runclaude-conventions-systems.md.
option global-context-path /root/.config/crush/CLAUDE.md

# --- Privacy: no telemetry ---
# Disable Crush's PostHog usage telemetry (endpoint data.charm.land). The image ALSO sets
# CRUSH_DISABLE_METRICS=1 / DO_NOT_TRACK=1 (Dockerfile ENV) — that env is the robust,
# launch-independent guarantee; this line documents the intent in the config the user reads and
# covers a config-only build. `metrics` is inverted, so `false` sets options.disable_metrics=true.
# (The unsolicited GitHub update check is disabled by a source patch — see
# client/patches/crush-no-update-check.patch and tasks/disable-crush-telemetry.md.)
option metrics false

# Offer ONLY this provider — never Crush's built-in Catwalk catalog. Without this, Crush
# shows ~15-20 embedded models (and, if our provider is ever dropped, falls into an onboarding
# picker of them). `default-providers` is inverted, so `false` = "do NOT include the built-in
# providers" (sets disable_default_providers=true). See
# tasks/suppress-embedded-provider-catalog.md.
option default-providers false

# --- Autodiscover the live models (decided 2026-09-20) ---
# This file is a real shell script (internal/shellconfig/load.go — same interpreter as the bash
# tool: functions, $(cmd) and external commands work, bounded by a 30 s load timeout). For each
# model in the server's table, PROBE its port and register a provider ONLY if it answers. A refused
# loopback connect returns instantly, so probing five closed ports costs nothing. This replaces the
# old "pin exactly two providers" scheme: Crush now offers whichever active ports are live, and the
# server's MODEL_COUNTRIES flag decides which those are (a disallowed model is never served, so its
# port never answers). The model ID registered (`<alias>/<alias>`) must match what the server
# reports at /v1/models — the server pins `--alias <MODEL_ALIAS_m>`, so these stay constant across
# quant/file changes. --context-window matches the server's -c/CTX (65536) so Crush's compaction
# math lines up (see tasks/archive/2026/08/20/context-window-sizing.md).
#
# PORT / ALIAS / NAME / CONTEXT table — keep in sync with server/Makefile MODEL_PORT_<m> +
# MODEL_ALIAS_<m>. (Gemma-4 licence check that let it in: tasks/reference/gemma-4-alongside-glimmer.md.)
first_live=""
have_curl=0
command -v curl >/dev/null 2>&1 && have_curl=1

try_model() {
  # $1 port  $2 alias/id  $3 display-name  $4 context-window
  [ "$have_curl" = 1 ] || return 0
  if curl -sf -m 2 -o /dev/null "http://127.0.0.1:$1/v1/models"; then
    provider add "$2" \
      --name "$3 (local llama.cpp)" \
      --type llamacpp \
      --base-url "http://127.0.0.1:$1" \
      --api-key "local-no-key-needed"
    model add "$2/$2" --name "$3" --context-window "$4"
    [ -z "$first_live" ] && first_live="$2"
  fi
}

try_model 8080 muse-glimmer "Muse Glimmer 30B"        65536
try_model 8081 gemma-4      "Gemma 4 26B-A4B"         65536
try_model 8082 granite-code "IBM Granite 34B Code"    65536
try_model 8083 devstral     "Devstral Small 2 (24B)"  65536
try_model 8084 qwen3-coder  "Qwen3-Coder 30B-A3B"     65536

# --- Preselect whichever model is actually being served ---
# Crush shows no onboarding picker as long as >=1 provider is enabled (onboarding runs only with
# ZERO enabled providers — internal/ui/model/ui.go `IsConfigured`), so preselect the first port
# that answered. If NONE answered (the tunnel isn't up yet at startup), pin the US default
# (Muse Glimmer, 8080) EXPLICITLY so Crush still never falls into the onboarding picker — it
# becomes reachable the moment the tunnel comes up; the wrong-preselect case only surfaces as a
# connection error on the first message. NOTE: a ctrl+l choice is written to
# ~/.local/share/crush/crush.json (UpdatePreferredModel, ScopeGlobal), merged AFTER this file and
# winning — but that path is on the ephemeral --rm overlay, so the probe decides again at every
# `make shell`. See tasks/reference/crush-capabilities.md § "Provider & model selection".
if [ -z "$first_live" ]; then
  provider add muse-glimmer \
    --name "Muse Glimmer 30B (local llama.cpp)" \
    --type llamacpp \
    --base-url "http://127.0.0.1:8080" \
    --api-key "local-no-key-needed"
  model add muse-glimmer/muse-glimmer --name "Muse Glimmer 30B" --context-window 65536
  first_live=muse-glimmer
fi
model large "$first_live/$first_live"
model small "$first_live/$first_live"

# --- Language servers: declared explicitly, dnf-installed, one per toolchain Fedora packages ---
# Crush bundles no servers; without these lines it auto-starts registry-known servers only when
# they pass four gates (not user-configured, not on its skip list, filetype + a root marker under
# /work, on PATH) and otherwise answers "no LSP client handles file" — which is what the maintainer
# saw for Python. An explicit `lsp add` skips every gate: the server starts for its filetypes, full
# stop. Every binary below comes from dnf in 01-install-base.sh (the airgap rebuild has only a dnf
# mirror, so no npm/gem/opam/pip servers — maintainer's rule, 2026-09-10); toolchains Fedora ships no
# server for (JS/TS, Lua, LaTeX, Haskell, Java, OCaml, Ruby, TOML, Markdown, YAML, Dockerfile, Emacs
# Lisp) deliberately have no line. Capability sets per server and the RHEL 9 variant (a /venv `ty`
# — same line, different install): tasks/reference/crush-lsp-integration.md.
# `ruff` is in the image for format.sh only — diagnostics-only and on Crush's skip list, no LSP role.
# SYNTAX GOTCHA (bit us 2026-09-10, startup died with "lsp add: unknown flag setup.py"): the usage
# text says `[--filetypes TYPE ...]`, but every `lsp add` flag takes exactly ONE value per occurrence
# (internal/shellconfig/flags.go parseFlagValue: flagString → i+2); `opAppend` means REPEAT the flag
# to add a value — `--filetypes go --filetypes mod`, as Crush's own load_test.go does. A second bare
# word is parsed as a flag name and aborts config loading, so Crush never starts.
# Named `ty` (not `python`): Crush's resolveServerName maps an unknown user name to the first
# bundled server whose command matches, and a server named `python` misresolves to the registry's
# `tvm_ffi_navigator` (command `python`); `ty` resolves cleanly. --filetypes py still binds it to
# Python files. (See tasks/lsp-python-server-not-registering.md.)
lsp add ty --command ty --args server --filetypes py \
    --root-markers pyproject.toml --root-markers setup.py --root-markers .git
lsp add go --command gopls --filetypes go \
    --root-markers go.mod --root-markers go.work --root-markers .git
lsp add c --command clangd --filetypes c --filetypes cpp --filetypes h --filetypes hpp \
    --root-markers compile_commands.json --root-markers CMakeLists.txt --root-markers Makefile --root-markers .git
lsp add rust --command rust-analyzer --filetypes rs \
    --root-markers Cargo.toml --root-markers .git
lsp add sh --command bash-language-server --args start --filetypes sh --filetypes bash \
    --root-markers .git
# glsl_analyzer (underscore — the Fedora package is glsl-analyzer) offers definition + diagnostics
# only; enough for mvp's shader trees, and free.
lsp add glsl --command glsl_analyzer --filetypes glsl --filetypes vert --filetypes frag --filetypes comp \
    --root-markers .git

# --- Permissions: auto-allow file read/write, ask for everything else ---
# The client is a throwaway container and the constant prompts for FILE ACCESS (read/write) are the
# real pain — so auto-allow just the file tools. EVERYTHING ELSE stays on ask (Crush's default),
# deliberately conservative: `bash`, network (`fetch`/`agentic_fetch`/`download`/`sourcegraph`), MCP
# (`list_mcp_resources`/`read_mcp_resource`), the `lsp_*` tools, sub-agents (`agent`), etc. all still
# prompt. `permissions allow` skips the prompt ONLY for the listed tools; unlisted and any
# newly-added tools ask (fail-safe). Tool names are Crush's registry (internal/config allToolNames).
# See the archived task auto-allow-local-file-tools.md.
permissions allow view edit multiedit write ls glob grep
